{
  "name": "fsirena-astro-me",
  "version": "0.2.0",
  "private": true,
  "description": "My Personal blog",
  "author": "Franco Sirena @francosirena",
  "engines": {
    "node": "21.x"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build ./src",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,astro}\"",
    "type-check": "astro check",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "start-server-and-test dev http://localhost:4321 cy:open",
    "test:e2e:ci": "start-server-and-test dev http://localhost:4321 cy:run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/react": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.6.1",
    "@babel/preset-typescript": "^7.12.7",
    "@testing-library/cypress": "^7.0.3",
    "@testing-library/react": "^11.2.2",
    "@types/jest": "^26.0.19",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^4.10.0",
    "@typescript-eslint/parser": "^4.10.0",
    "astro": "^5.16.8",
    "axe-core": "^4.1.1",
    "babel-jest": "^26.6.3",
    "cypress": "^6.2.0",
    "cypress-axe": "^0.12.0",
    "eslint": "^7.15.0",
    "eslint-config-react-app": "^6.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^26.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.0",
    "start-server-and-test": "^1.11.7"
  },
  "keywords": [
    "astro",
    "blog",
    "personal-site"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FrancoSirena/gatsby-me"
  },
  "packageManager": "yarn@4.12.0"
}
